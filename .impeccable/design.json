      "kind": "card",
      "refersTo": "document-surface",
      "description": "One shared white surface with open sections and a fine internal rule.",
      "html": "<article class=\"ds-document\"><section class=\"ds-section\"><h2>Rincian laporan</h2><p>Baca kembali cerita contoh sebelum melanjutkan.</p></section><section class=\"ds-section\"><h2>Bukti pendukung</h2><p>Tambahkan berkas yang relevan.</p></section></article>",
      "css": ".ds-document{background:var(--surface,#fff);color:var(--ink,#123c32);border-radius:var(--radius,14px);padding:32px;font:15px/1.65 var(--body,Inter,sans-serif)}.ds-section{padding:24px 0;border-bottom:1px solid var(--line,#d8e0d2)}.ds-section:first-child{padding-top:0}.ds-section:last-child{border-bottom:0;padding-bottom:0}.ds-section h2{margin:0 0 12px;font:600 23px/1.25 var(--display,\"Bricolage Grotesque\",sans-serif)}.ds-section p{margin:0;color:var(--muted,#53685d);font-size:14px}"
    },
