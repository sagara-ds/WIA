  "narrative": {
    "northStar": "Ruang Warga",
    "overview": "Ruang Warga is a welcoming civic information board: confident humanist headings, continuous deep green public surfaces, chartreuse actions, and open document sections. It makes reporting and follow-up feel approachable while preserving the visible Indonesian SIAP identity and prototype boundary.\n\nLight surfaces support prolonged reading, forms, and staff work. Fine rules, restrained color changes, and authored geometric SVGs organize information without decorative imagery. The homepage composition is recorded in its surface brief; it is not a template for every route.",
    "keyCharacteristics": [
      "Confident Bricolage Grotesque headings with readable Inter text.",
      "Deep green continuity, chartreuse emphasis, and pale document surfaces.",
      "Fine rules, modest corners, and geometric line icons.",
      "Connected progress and explicit loading, empty, error, and validation states."
    ],
    "rules": [
      {
        "name": "The Public Surface Rule",
        "body": "Use the green and chartreuse relationship for orientation and action; use light document surfaces when the task requires sustained reading or input.",
        "section": "colors"
      },
      {
        "name": "The Reading Hierarchy Rule",
        "body": "Reserve Bricolage Grotesque for headings and prominent numbers; keep instructions, labels, controls, and operational data in Inter.",
        "section": "typography"
      },
      {
