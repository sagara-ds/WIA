      "css": ".ds-progress{display:flex;gap:0;max-width:650px;list-style:none;padding:0;margin:0;font:13px/1.65 var(--body,Inter,sans-serif);color:var(--muted,#53685d)}.ds-progress li{display:flex;align-items:center;flex:1;gap:10px}.ds-progress li:not(:last-child)::after{content:\"\";flex:1;height:1px;background:#b9c7b1;margin:0 16px 0 6px}.ds-progress li>span:first-child{display:grid;place-items:center;flex:none;width:32px;height:32px;border:1px solid #b9c7b1;border-radius:50%}.ds-progress .ds-done,.ds-progress [aria-current=\"step\"]{color:var(--ink,#123c32);font-weight:650}.ds-progress .ds-done>span:first-child{background:var(--accent,#d9f36b);border-color:var(--accent,#d9f36b)}.ds-progress [aria-current=\"step\"]>span:first-child{background:var(--brand,#123c32);border-color:var(--brand,#123c32);color:var(--accent,#d9f36b);animation:ds-arrive .35s cubic-bezier(.16,1,.3,1)}.ds-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}@keyframes ds-arrive{from{box-shadow:0 5px 12px #123c3233}to{box-shadow:0 1px 2px #123c3200}}@media(prefers-reduced-motion:reduce){.ds-progress [aria-current=\"step\"]>span:first-child{animation:none}}"
    }
